# Copie este archivo a config/entorno.env y complete las claves del SANDBOX. entorno.env NO se versiona.
# Escriba los valores tal cual: sin comillas, sin espacios y sin los < > (por ejemplo ETL_SQL_CLAVE=MiClave123!).
ETL_ENTORNO=SANDBOX
ETL_SQL_HOST=sandbox-sql
ETL_SQL_PUERTO=1433
ETL_SQL_USUARIO=sa
ETL_SQL_CLAVE=<clave del SQL Server del sandbox>
ETL_MONGO_URI=mongodb://<usuario>:<clave>@mongo-lab:27017/?authSource=admin
ETL_USUARIO=luis.diaz
